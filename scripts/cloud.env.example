# ~/.config/tvt/cloud.env for scripts/cloud-nightly.sh: the Grafana Cloud
# test stack's URLs and user IDs. None of these is secret; the two tokens
# live in the login Keychain (service tvt-cloud), never here.
GRAFANA_URL=https://<stack>.grafana.net
PROM_URL=https://prometheus-prod-<n>-<region>.grafana.net/api/prom
PROM_USER=<metrics instance ID>
LOKI_URL=https://logs-prod-<n>.grafana.net
LOKI_USER=<logs instance ID>
