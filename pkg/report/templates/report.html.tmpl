<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tvt report: scan {{.Scan.ID}}</title>
<style>
:root { --fg:#1d1f23; --muted:#5f6670; --line:#dde1e6; --bg:#fff; --soft:#f5f7f9; --warn:#8a5a00; --warnbg:#fff6e0; --accent:#1f5fbf; }
@media (prefers-color-scheme: dark) { :root { --fg:#e6e8eb; --muted:#9aa3ad; --line:#353a41; --bg:#16181b; --soft:#1f2226; --warn:#f0c264; --warnbg:#2c2414; --accent:#7fb0ff; } }
* { box-sizing: border-box; }
body { margin:0; font:14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color:var(--fg); background:var(--bg); }
main { max-width:1100px; margin:0 auto; padding:24px 16px 64px; }
h1 { font-size:22px; margin:0 0 4px; }
h2 { font-size:16px; margin:32px 0 8px; }
.muted { color:var(--muted); }
.cards { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin:16px 0; }
.card { background:var(--soft); border:1px solid var(--line); border-radius:8px; padding:12px; }
.card b { display:block; font-size:20px; }
.gaps { background:var(--warnbg); color:var(--warn); border-radius:8px; padding:10px 14px; }
.gaps ul { margin:4px 0 0; padding-left:18px; }
table { width:100%; border-collapse:collapse; }
th, td { text-align:left; padding:8px 6px; border-bottom:1px solid var(--line); vertical-align:top; }
th { font-size:12px; color:var(--muted); font-weight:600; }
td.num, th.num { text-align:right; white-space:nowrap; }
code { font:12px ui-monospace, SFMono-Regular, Menlo, monospace; word-break:break-all; }
.tag { display:inline-block; font-size:11px; padding:1px 6px; border-radius:10px; border:1px solid var(--line); color:var(--muted); }
details { margin-top:6px; }
summary { cursor:pointer; color:var(--accent); }
.detail { background:var(--soft); border-radius:6px; padding:8px 10px; margin-top:6px; }
.detail ul { margin:2px 0 8px; padding-left:18px; }
.rowgap { color:var(--warn); font-size:12px; }
.table-wrap { overflow-x:auto; }
</style>
</head>
<body>
<main>
<h1>Telemetry Value Tracker report</h1>
<p class="muted">Scan {{.Scan.ID}}, {{.Scan.WindowDays}}-day window to {{date .Scan.StartedAt}}{{if .Scan.PriceCard}}, priced on {{.Scan.PriceCard}}{{if .Scan.Approximate}} (a vendor preset: approximate){{end}}{{end}}. Generated {{when .GeneratedAt}} UTC.</p>
{{if .Scan.RepricedFrom}}<p class="rowgap"><b>What-if pricing</b>: the scan was priced on {{.Scan.RepricedFrom}}; every cost, saving and priority here is repriced on {{.Scan.PriceCard}} without rescanning. Evidence and confidence are the scan's.</p>{{end}}

<div class="cards">
  <div class="card"><span class="muted">Recommendations</span><b>{{.Totals.Recommendations}}</b><span class="muted">of {{.Totals.Candidates}} candidates</span></div>
  <div class="card"><span class="muted">Metric savings / month</span><b>{{money .Totals.MetricSavings .Scan.Currency}}</b></div>
  {{if .Totals.StreamSavings}}<div class="card"><span class="muted">Stream savings / month</span><b>up to {{money .Totals.StreamSavings .Scan.Currency}}</b><span class="muted">selectors overlap</span></div>{{end}}
  <div class="card"><span class="muted">Usage log coverage</span><b>{{pct .Scan.LogCoverage}}</b></div>
  {{range $reason, $n := .Held}}<div class="card"><span class="muted">Held: {{$reason}}</span><b>{{$n}}</b><span class="muted">not recommended yet</span></div>{{end}}
</div>

{{if .Gaps}}
<div class="gaps"><b>Evidence gaps</b>: a reader these would have shown can't be ruled out. Unacknowledged gaps show on every row they affect; acknowledge one in tvt.yaml (<code>gaps.acknowledge</code>) with a reason.
<ul>{{range .Gaps}}<li><span class="tag">{{.Kind}}</span> {{.Text}}{{if .Acknowledged}} <span class="muted">(acknowledged: {{.Reason}})</span>{{end}}</li>{{end}}</ul>
{{if .UnmatchedAcknowledgements}}<p>Acknowledgements that match no gap (remove them from tvt.yaml):</p><ul>{{range .UnmatchedAcknowledgements}}<li>{{.Source}}{{if .Match}} matching "{{.Match}}"{{end}}: {{.Reason}}</li>{{end}}</ul>{{end}}
</div>
{{end}}

<h2>Recommendations</h2>
<p class="muted">Ranked by savings per minute of checking. Confirm each with its cheapest check before anything changes.</p>
<div class="table-wrap">
<table>
<thead><tr><th>#</th><th>Change</th><th>Claim and check</th><th class="num">Saves / month</th><th class="num">Check</th><th>Owner</th></tr></thead>
<tbody>
{{range $i, $r := .Recommendations}}
<tr class="rec" id="{{$r.ID}}">
<td class="num">{{inc $i}}</td>
<td><span class="tag">{{$r.Action}}</span><br><code>{{$r.Signal.ID}}</code></td>
<td>{{$r.Claim}}<br><b>Check:</b> {{$r.CheapestCheck}}
{{if $r.Evidence.Gaps}}<div class="rowgap">Gaps: {{join $r.Evidence.Gaps "; "}}</div>{{end}}
{{if $r.Evidence.Acknowledged}}<div class="muted" style="font-size:12px">Acknowledged: {{join $r.Evidence.Acknowledged "; "}}</div>{{end}}
<details><summary>Evidence, readers and assumptions</summary><div class="detail">
<b>Every reader</b>: <code>{{why $r.Signal.ID}}</code><br>
<b>Score</b>: usage weight {{printf "%.2f" $r.Score.UsageWeight}} ({{$r.Score.Strongest}}), confidence {{printf "%.2f" $r.Score.Confidence}}, priority {{printf "%.2f" $r.Score.Priority}}.
Risk if wrong: strongest reader evidence {{$r.RiskIfWrong.Evidence}}{{if $r.RiskIfWrong.Dormant}}, dormant{{end}}{{if $r.RiskIfWrong.Tier}}, tier {{$r.RiskIfWrong.Tier}}{{end}}.
{{with $r.Evidence.LastRead}}<br><b>Last read</b>: {{when .At}}{{if .Actor}} by {{.Actor}}{{end}} (<code>{{.Consumer}}</code>).{{end}}
<br><b>Readers</b>{{if not $r.Downstream}}: none.{{end}}
{{if $r.Downstream}}<ul>{{range $r.Downstream}}<li>{{.Name}} <span class="tag">{{.Kind}}</span> <span class="tag">{{.Evidence}}</span> from {{.Source}}{{if .Sweep}}, a sweep{{end}}{{if not .Exact}}, inferred{{end}}{{if .Actor}}, by {{.Actor}}{{end}}{{if not .LastSeen.IsZero}}, last {{when .LastSeen}}{{end}}</li>{{end}}</ul>{{end}}
{{if $r.Evidence.QueryLog}}<b>Logged queries</b><ul>{{range $r.Evidence.QueryLog}}<li><code>{{.Expr}}</code>{{if .Client}} ({{.Client}}){{end}}</li>{{end}}</ul>{{end}}
{{if $r.Assumptions}}<b>Assumptions</b><ul>{{range $r.Assumptions}}<li>{{.}}</li>{{end}}</ul>{{end}}
</div></details>
</td>
<td class="num">{{money $r.Savings.Monthly $r.Savings.Currency}}{{if $r.Savings.Approximate}}<br><span class="muted">approx.</span>{{end}}</td>
<td class="num">{{$r.CheckMinutes}} min</td>
<td>{{if $r.Owner}}{{$r.Owner}}{{else}}<span class="muted">unknown</span>{{end}}</td>
</tr>
{{else}}
<tr><td colspan="6" class="muted">Nothing to recommend{{if .Held}}: every candidate is held (see above){{end}}.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Evidence kept per service</h2>
<p class="muted">What tvt would cut next to what stays protected. Kept counts are metrics and streams (a label's cost is part of its metric's); cut counts every recommendation, not only the top rows.</p>
<div class="table-wrap">
<table>
<thead><tr><th>Service</th><th class="num">Would cut</th><th class="num">Hard keep</th><th class="num">keep_high</th><th class="num">Dormant</th><th class="num">Incident</th><th class="num">Records</th></tr></thead>
<tbody>{{$cur := .Scan.Currency}}{{range .Services}}<tr><td>{{.Name}}</td>
<td class="num">{{.Cut.Signals}}<br><span class="muted">{{money .Cut.Monthly $cur}}</span></td>
<td class="num">{{.HardKeep.Signals}}<br><span class="muted">{{money .HardKeep.Monthly $cur}}</span></td>
<td class="num">{{.KeepHigh.Signals}}<br><span class="muted">{{money .KeepHigh.Monthly $cur}}</span></td>
<td class="num">{{.Dormant.Signals}}<br><span class="muted">{{money .Dormant.Monthly $cur}}</span></td>
<td class="num">{{.Incident.Signals}}<br><span class="muted">{{money .Incident.Monthly $cur}}</span></td>
<td class="num">{{.Records.Signals}}<br><span class="muted">{{money .Records.Monthly $cur}}</span></td></tr>{{end}}</tbody>
</table>
</div>

<h2>Dormant: confirm</h2>
<p class="muted">Nothing read these, but they look incident-critical. They are never drop candidates: each is a question for its owner.{{if gt .Totals.Dormant (len .Confirm)}} The {{len .Confirm}} with the largest saving of {{.Totals.Dormant}} dormant signals (labels of a listed metric are covered by its row).{{end}}</p>
<div class="table-wrap">
<table>
<thead><tr><th>Signal</th><th>Question for the owner</th><th class="num">If dropped / month</th><th>Owner</th></tr></thead>
<tbody>
{{range .Confirm}}
<tr class="confirm" id="{{.ID}}"><td><span class="tag">dormant: confirm</span><br><code>{{.Signal.ID}}</code></td>
<td>{{.Question}}{{if .Gaps}}<div class="rowgap">Gaps: {{join .Gaps "; "}}</div>{{end}}<div class="muted" style="font-size:12px">Every reader: <code>{{why .Signal.ID}}</code></div></td>
<td class="num">{{money .Savings.Monthly .Savings.Currency}}</td>
<td>{{if .Owner}}{{.Owner}}{{else}}<span class="muted">unknown</span>{{end}}{{if .Tier}}<br><span class="muted">tier {{.Tier}}</span>{{end}}</td></tr>
{{else}}
<tr><td colspan="4" class="muted">No dormant signals.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Line-level findings</h2>
<p class="muted">Line patterns inside a stream worth cutting, from Loki's pattern API over its last few hours. Savings are estimates (patterns count lines, not bytes). tvt never writes a line filter: <a href="{{zeroreads}}">zeroreads</a> proves which lines nothing reads and generates the cut.</p>
<div class="table-wrap">
<table>
<thead><tr><th>Stream and pattern</th><th>What to do</th><th class="num">Lines/s</th><th class="num">Saving / month</th></tr></thead>
<tbody>
{{range .LineFindings}}
<tr id="{{.ID}}"><td><span class="tag">{{if eq .Kind "repeated_line"}}repeated line{{else}}hand-off to zeroreads{{end}}</span><br><code>{{.Stream}}</code><br><code>{{.Pattern}}</code></td>
<td>{{.Action}}</td>
<td class="num">{{printf "%.2f" .PerSecond}}</td>
<td class="num">{{money .Savings.Monthly .Savings.Currency}}<br><span class="muted">{{pct .Share}} of the stream</span></td></tr>
{{else}}
<tr><td colspan="4" class="muted">No line findings.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>Rules</h2>
<p class="muted">Every rule's evaluations: how often it runs and what each evaluation read, measured from the query logs (samples for PromQL, bytes for LogQL). Rules with findings come first. Report only: tvt never edits a rule.</p>
<div class="table-wrap">
<table>
<thead><tr><th>Rule</th><th>Findings</th><th class="num">Evaluations / day</th><th class="num">Read / day</th></tr></thead>
<tbody>
{{range .Rules}}
<tr id="{{.ID}}"><td><strong>{{.Name}}</strong><br><span class="tag">{{.Source}} {{.Kind}}{{if .EvaluatedBy}}, evaluated by {{.EvaluatedBy}}{{end}}</span><br><code>{{.Expr}}</code></td>
<td>{{range .Findings}}<p><span class="tag">{{.Kind}}</span> {{.Detail}}<br><span class="muted">Fix: {{.Fix}}</span></p>{{else}}<span class="muted">None</span>{{end}}</td>
<td class="num">{{if .EvalsPerDay}}{{printf "%.0f" .EvalsPerDay}}{{else}}<span class="muted">unknown</span>{{end}}</td>
<td class="num">{{if .CostUnknown}}<span class="muted">unknown: {{.CostUnknown}}</span>{{else}}{{if .SamplesPerDay}}{{printf "%.0f" .SamplesPerDay}} samples{{end}}{{if .BytesPerDay}}{{if .SamplesPerDay}}<br>{{end}}{{bytes .BytesPerDay}}{{end}}<br><span class="muted">from {{.Evaluations}} evaluations</span>{{end}}</td></tr>
{{else}}
<tr><td colspan="4" class="muted">No rules.</td></tr>
{{end}}
</tbody>
</table>
</div>

<h2>SLO coverage</h2>
<p class="muted">Report only. Services are the owners tvt.yaml names; paging alerts are severity critical or page.</p>
{{define "slorows"}}{{range .}}<tr><td>{{.Name}}</td><td>{{.Detail}}<br><span class="muted">Fix: {{.Fix}}</span></td></tr>{{else}}<tr><td colspan="2" class="muted">None.</td></tr>{{end}}{{end}}
<div class="table-wrap">
<table>
<thead><tr><th>Service without an SLO</th><th>Why</th></tr></thead>
<tbody>{{template "slorows" .SLOCoverage.ServicesWithoutSLO}}</tbody>
<thead><tr><th>Paging alert not on burn rate</th><th>Why</th></tr></thead>
<tbody>{{template "slorows" .SLOCoverage.PagingNotBurnRate}}</tbody>
<thead><tr><th>SLO without an alert</th><th>Why</th></tr></thead>
<tbody>{{template "slorows" .SLOCoverage.SLOsWithoutAlert}}</tbody>
</table>
</div>

<h2>Query load</h2>
<p class="muted">What the logged queries read in the window, as the backends report it (samples for PromQL, bytes for LogQL), by who sent them. A query matching several panels or rules is split evenly among them.</p>
<div class="table-wrap">
<table>
<thead><tr><th>Client</th><th class="num">Queries</th><th class="num">Samples</th><th class="num">Bytes</th></tr></thead>
<tbody>
{{range .QueryLoad.Clients}}
<tr><td>{{.Client}}</td><td class="num">{{printf "%.0f" .Queries}}<br><span class="muted">{{pct .QueryShare}}</span></td><td class="num">{{printf "%.0f" .Samples}}<br><span class="muted">{{pct .SampleShare}}</span></td><td class="num">{{bytes .Bytes}}<br><span class="muted">{{pct .ByteShare}}</span></td></tr>
{{else}}
<tr><td colspan="4" class="muted">No query log read.</td></tr>
{{end}}
</tbody>
</table>
</div>
{{if .QueryLoad.Top}}
<div class="table-wrap">
<table>
<thead><tr><th>Most expensive to run</th><th>Client</th><th class="num">Queries</th><th class="num">Samples</th><th class="num">Bytes</th></tr></thead>
<tbody>
{{range .QueryLoad.Top}}
<tr><td>{{.Name}}</td><td>{{.Client}}</td><td class="num">{{printf "%.0f" .Queries}}</td><td class="num">{{printf "%.0f" .Samples}}</td><td class="num">{{bytes .Bytes}}</td></tr>
{{end}}
</tbody>
</table>
</div>
{{end}}

<h2>Evidence sources</h2>
<div class="table-wrap">
<table>
<thead><tr><th>Source</th><th>Configured</th><th class="num">Coverage</th><th>Gap</th></tr></thead>
<tbody>{{range .Sources}}<tr><td>{{.Name}}</td><td>{{if .Configured}}yes{{else}}no{{end}}</td><td class="num">{{pct .Coverage}}</td><td>{{.Gap}}</td></tr>{{end}}</tbody>
</table>
</div>
<p class="muted">Rendered from report.json (version {{.Version}}). tvt is read-only: nothing changes until a reviewed pull request.</p>
</main>
</body>
</html>
