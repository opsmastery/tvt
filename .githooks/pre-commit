#!/usr/bin/env bash
# tvt pre-commit: fast checks on what is staged. Enable with `make hooks`.
# Skip once with `git commit --no-verify` (CI runs the same checks).
set -eu

fail() { printf 'pre-commit: %s\n' "$*" >&2; exit 1; }

has_staged=false
has_go=false
has_go_mod=false
has_schema=false
unformatted=false

while IFS= read -r -d '' f; do
	has_staged=true

	# 1. Files that must never be committed: internal planning, scan databases,
	#    local configs and price cards (negotiated prices), env files and keys.
	#    .gitignore covers most of these; this also catches `git add -f`.
	case "$f" in
		docs/plan.md|*.db|*.db-journal|*.db-shm|*.db-wal|tvt.yaml|pricecard.yaml|*.key)
			fail "these files must not be committed: $f"
			;;
	esac
	case "${f##*/}" in
		.env*)
			fail "these files must not be committed: $f"
			;;
	esac

	case "$f" in
		*.go)
			has_go=true
			# 2. gofmt, on the staged content rather than the working tree.
			if [ -n "$(git show ":$f" | gofmt -l 2>&1)" ]; then
				printf 'pre-commit: gofmt needed: %s\n' "$f" >&2
				unformatted=true
			fi
			;;
		go.mod|go.sum)
			has_go_mod=true
			;;
		pkg/graph/schema.sql|pkg/store/*)
			has_schema=true
			;;
	esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ "$has_staged" = true ] || exit 0
[ "$unformatted" = false ] || fail "gofmt needed (run make fmt, then git add)"

# 3. go vet.
if [ "$has_go" = true ]; then
	go vet ./... || fail "go vet failed"
fi

# 4. go.mod and go.sum tidy.
if [ "$has_go_mod" = true ]; then
	go mod tidy -diff >/dev/null || fail "go.mod/go.sum not tidy (run go mod tidy)"
fi

# 5. Schema changes: a new SchemaVersion, upgrade step and frozen copy.
if [ "$has_schema" = true ]; then
	go test -count=1 -run 'Schema|Upgrade' ./pkg/store >/dev/null ||
		fail "store schema tests failed (go test -run 'Schema|Upgrade' ./pkg/store)"
fi

# 6. Secrets in the staged diff, before they reach GitHub.
command -v gitleaks >/dev/null 2>&1 ||
	fail "gitleaks not installed (brew install gitleaks); it keeps tokens out of commits"
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn ||
	fail "gitleaks found a possible secret in the staged changes"
